{% extends 'admin/base.html.twig' %}

{% block title %}HM Café | Dashboard{% endblock %}

{% block body %}
<div class="admin-welcome">
    <h1>Welcome, <span>{{ app.user ? app.user.userIdentifier : 'Admin' }}</span> 👋</h1>
</div>

<!-- RUBRIC METRICS: TOTAL USERS, TOTAL STAFF, TOTAL RECORDS -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-bottom: 25px;">
    <div style="background: linear-gradient(135deg, #111 0%, #171717 100%); border: 1px solid #00d414; border-radius: 12px; padding: 18px 22px;">
        <span style="font-size: 11px; letter-spacing: 2px; color: #888; font-weight: 700; display: block; margin-bottom: 6px;">👥 TOTAL USERS</span>
        <strong style="font-size: 32px; color: #fff; line-height: 1;">{{ userCount }}</strong>
        <small style="display: block; color: #aaa; font-size: 11px; margin-top: 6px;">{{ customerCount }} customers &bull; {{ adminCount }} admins</small>
    </div>
    <div style="background: linear-gradient(135deg, #111 0%, #171717 100%); border: 1px solid #ffd700; border-radius: 12px; padding: 18px 22px;">
        <span style="font-size: 11px; letter-spacing: 2px; color: #888; font-weight: 700; display: block; margin-bottom: 6px;">👔 TOTAL STAFF</span>
        <strong style="font-size: 32px; color: #ffd700; line-height: 1;">{{ staffCount }}</strong>
        <small style="display: block; color: #aaa; font-size: 11px; margin-top: 6px;">Authorized staff accounts</small>
    </div>
    <div style="background: linear-gradient(135deg, #111 0%, #171717 100%); border: 1px solid #3388ff; border-radius: 12px; padding: 18px 22px;">
        <span style="font-size: 11px; letter-spacing: 2px; color: #888; font-weight: 700; display: block; margin-bottom: 6px;">📁 TOTAL SYSTEM RECORDS</span>
        <strong style="font-size: 32px; color: #3388ff; line-height: 1;">{{ totalRecords }}</strong>
        <small style="display: block; color: #aaa; font-size: 11px; margin-top: 6px;">{{ prodCount }} products &bull; {{ orderCounts.all|default(0) }} orders &bull; {{ bookingCount }} bookings</small>
    </div>
</div>

<!-- STATS STRIP -->
<div class="admin-stat-banner">
    <div class="admin-stat-card revenue">
        <span>TOTAL REVENUE</span>
        <strong>₱{{ revenue|number_format(2) }}</strong>
        <small>Active &amp; completed orders</small>
    </div>
    <div class="admin-stat-card pending">
        <span>PENDING REQUESTS</span>
        <strong>{{ orderCounts.pending|default(0) }}</strong>
        <small>Requires barista action</small>
    </div>
    <div class="admin-stat-card completed">
        <span>COMPLETED REQUESTS</span>
        <strong>{{ orderCounts.completed|default(0) }}</strong>
        <small>{{ orderCounts.all|default(0) }} total requests</small>
    </div>
    <div class="admin-stat-card">
        <span>INQUIRIES &amp; MESSAGES</span>
        <strong>{{ msgCount }}</strong>
        <small>Contact form submissions</small>
    </div>
</div>

<!-- MAIN SECTIONS GRID -->
<div class="admin-cards" style="grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));">
    <a href="{{ path('admin_orders') }}" class="admin-card-link" style="text-decoration: none;">
        <strong>{{ orderCounts.all|default(0) }}</strong>
        <span>REQUESTS &amp; ORDERS</span>
        <p>Manage order tickets, status, and receipts</p>
    </a>
    <a href="{{ path('admin_bookings') }}" class="admin-card-link" style="text-decoration: none;">
        <strong>{{ bookingCount }}</strong>
        <span>TABLE BOOKINGS</span>
        <p>Review customer reservations and confirmations</p>
    </a>
    <a href="{{ path('admin_messages') }}" class="admin-card-link" style="text-decoration: none;">
        <strong>{{ msgCount }}</strong>
        <span>CONTACT MESSAGES</span>
        <p>Customer inquiries, feedback &amp; questions</p>
    </a>
    <a href="{{ path('admin_products') }}" class="admin-card-link" style="text-decoration: none;">
        <strong>{{ prodCount }}</strong>
        <span>MENU &amp; PRODUCTS</span>
        <p>Catalog items, prices, and stock inventory</p>
    </a>
    <a href="{{ path('admin_clients') }}" class="admin-card-link" style="text-decoration: none;">
        <strong>{{ userCount }}</strong>
        <span>CLIENTS DIRECTORY</span>
        <p>Manage registered users and staff roles</p>
    </a>
    <a href="{{ path('admin_settings') }}" class="admin-card-link" style="text-decoration: none;">
        <strong style="font-size: 32px;">⚙️</strong>
        <span>SYSTEM SETTINGS</span>
        <p>Security, credentials, and environment info</p>
    </a>
</div>

<!-- RECENT ORDERS TABLE -->
<div class="admin-panel-card" style="margin-top: 35px; padding: 0; overflow: hidden;">
    <div style="padding: 18px 24px; border-bottom: 1px solid #222; display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 16px;">📋 Recent Customer Requests</h2>
        <span style="font-size: 11px; color: #888;">Live Doctrine ORM Query</span>
    </div>
    <div class="orders-table-wrap">
        <table class="user-table">
            <thead>
                <tr>
                    <th>REFERENCE #</th>
                    <th>CLIENT</th>
                    <th>ITEM &amp; DINING</th>
                    <th>QTY</th>
                    <th>TOTAL</th>
                    <th>STATUS</th>
                    <th>TIME</th>
                </tr>
            </thead>
            <tbody>
                {% if recentOrders is empty %}
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: #555;">
                            <div style="font-size: 32px; margin-bottom: 10px;">📭</div>
                            No requests placed yet.
                        </td>
                    </tr>
                {% else %}
                    {% for order in recentOrders %}
                        <tr>
                            <td>
                                <span style="color: var(--green); font-weight: 800; background: rgba(0,212,20,0.1); border: 1px solid rgba(0,212,20,0.3); padding: 3px 8px; border-radius: 6px; font-size: 12px;">
                                    #{{ order.id|format('%04d') }}
                                </span>
                            </td>
                            <td>
                                <strong style="color: #fff;">{{ order.user ? order.user.username : 'Guest' }}</strong>
                            </td>
                            <td>
                                <span style="color: #fff; font-weight: 600;">{{ order.product ? order.product.name : 'Unknown Product' }}</span>
                                <span style="display: block; font-size: 11px; color: #aaa; margin-top: 2px;">
                                    🍽️ {{ order.diningOption }} &bull; 💳 {{ order.paymentMethod }}
                                </span>
                            </td>
                            <td>x{{ order.quantity }}</td>
                            <td><strong style="color: #ffd700;">₱{{ order.totalPrice|number_format(2) }}</strong></td>
                            <td>
                                <span class="status-badge {{ order.status|lower }}">
                                    {{ order.status }}
                                </span>
                            </td>
                            <td style="font-size: 12px; color: #888;">{{ order.createdAt|date('M d, g:i A') }}</td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
