<header class="header" style="position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; width: 100% !important; z-index: 999999 !important; background: rgba(0, 0, 0, 0.96) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border-bottom: 1px solid rgba(0, 212, 20, 0.25) !important;">
    <a href="{{ path('app_home') }}#home" class="brand">
        <img src="{{ asset('assets/logo.png') }}" alt="HM Café Logo">
        <span><strong>HM <em>Café</em></strong></span>
    </a>
    <nav class="main-nav" id="mainNav">
        <a href="{{ path('app_home') }}#home">HOME</a>
        <a href="{{ path('app_home') }}#menu">MENU</a>
        <a href="{{ path('app_home') }}#about">ABOUT US</a>
        <a href="{{ path('app_home') }}#gallery">GALLERY</a>
        <a href="{{ path('app_home') }}#events">EVENTS</a>
        <a href="{{ path('app_home') }}#contact">CONTACT</a>
    </nav>
    <div class="nav-account">
        {% if app.user %}
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_dashboard') }}" class="order" style="border-color:#ffd700; color:#ffd700; margin-right:8px; padding:6px 12px; font-size:11px;">⚡ DASHBOARD</a>
            {% elseif is_granted('ROLE_STAFF') %}
                <a href="{{ path('staff_products') }}" class="order" style="border-color:#ffd700; color:#ffd700; margin-right:8px; padding:6px 12px; font-size:11px;">🛠️ STAFF PORTAL</a>
            {% endif %}
            <a href="{{ path('app_my_orders') }}" class="order" style="border-color:#00d414; color:#00d414; margin-right:8px; padding:6px 12px; font-size:11px;">📋 MY ORDERS</a>
            <a href="{{ path('app_shop') }}" class="order" style="margin-right:8px;">☕ ORDER NOW</a>
            <a href="{{ path('app_logout') }}" class="order logout-button" style="padding:8px 12px; font-size:11px; text-decoration:none;">LOGOUT</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="order" style="margin-right:8px;">LOGIN</a>
            <a href="{{ path('app_shop') }}" class="order">☕ ORDER NOW</a>
        {% endif %}
    </div>
    <button class="hamburger" id="hamburger" type="button" aria-label="Open navigation menu" aria-expanded="false">☰</button>
</header>
