{% extends 'admin/base.html.twig' %}

{% block title %}HM Café | User & Staff Management{% endblock %}

{% block body %}
<div class="admin-welcome" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
    <div>
        <h1>👥 User &amp; Staff Management</h1>
        <p>Full administrative control: create, edit, disable, or delete staff and customer accounts.</p>
    </div>
    <button type="button" class="btn-admin-primary" onclick="document.getElementById('createUserModal').style.display='flex';" style="padding: 10px 18px; font-size: 13px;">
        ➕ Create New Account (Staff/Admin)
    </button>
</div>

<!-- STATS STRIP -->
<div class="admin-stat-banner" style="margin-bottom: 25px;">
    <div class="admin-stat-card">
        <span>TOTAL ACCOUNTS</span>
        <strong>{{ totalUsers }}</strong>
        <small>All registered records</small>
    </div>
    <div class="admin-stat-card revenue">
        <span>CUSTOMERS</span>
        <strong>{{ totalCustomers }}</strong>
        <small>Client ordering accounts</small>
    </div>
    <div class="admin-stat-card" style="border-color: #ffd700;">
        <span style="color: #ffd700;">STAFF MEMBERS</span>
        <strong style="color: #ffd700;">{{ totalStaff }}</strong>
        <small>Inventory &amp; record handlers</small>
    </div>
    <div class="admin-stat-card completed">
        <span>ADMINISTRATORS</span>
        <strong>{{ totalAdmins }}</strong>
        <small>Full administrative access</small>
    </div>
</div>

<!-- FILTER BAR -->
<div class="admin-panel-card" style="margin-bottom: 20px; padding: 14px 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
            <span style="font-size: 12px; color: #888; font-weight: 700;">ROLE:</span>
            {% for r in ['all', 'admin', 'staff', 'customer'] %}
                <a href="{{ path('admin_clients', {role: r, status: statusFilter, search: search}) }}" 
                   class="hero-btn {{ roleFilter == r ? 'green-btn' : 'outline-btn' }}" 
                   style="padding: 5px 12px; font-size: 11px;">
                    {{ r|upper }}
                </a>
            {% endfor %}
        </div>
        <form method="get" action="{{ path('admin_clients') }}" style="display: flex; gap: 8px; margin: 0;">
            <input type="hidden" name="role" value="{{ roleFilter }}">
            <input type="hidden" name="status" value="{{ statusFilter }}">
            <input type="text" name="search" value="{{ search }}" placeholder="Search username, email..."
                   style="padding: 7px 12px; background: #181818; border: 1px solid #333; color: #fff; border-radius: 6px; font-size: 12px;">
            <button type="submit" class="btn-admin-primary" style="padding: 7px 14px; font-size: 12px;">Search</button>
            {% if search != '' %}
                <a href="{{ path('admin_clients', {role: roleFilter, status: statusFilter}) }}" class="btn-admin-outline" style="padding: 7px 10px; font-size: 12px;">Clear</a>
            {% endif %}
        </form>
    </div>
</div>

<!-- CLIENTS TABLE -->
<div class="admin-panel-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 18px 24px; border-bottom: 1px solid #222; display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 16px;">User Directory ({{ clients|length }})</h2>
        <span style="font-size: 12px; color: #888;">Active Doctrine Query</span>
    </div>

    <div class="orders-table-wrap">
        <table class="user-table">
            <thead>
                <tr>
                    <th>USER ID</th>
                    <th>USERNAME</th>
                    <th>EMAIL</th>
                    <th>ROLE</th>
                    <th>STATUS</th>
                    <th>DATE CREATED</th>
                    <th style="text-align: right;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                {% if clients is empty %}
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: #555;">
                            No user records found matching criteria.
                        </td>
                    </tr>
                {% else %}
                    {% for c in clients %}
                        <tr>
                            <td>
                                <span style="color: var(--green); font-weight: 700;">#{{ c.id }}</span>
                            </td>
                            <td>
                                <strong style="color: #fff; font-size: 14px;">{{ c.username }}</strong>
                                {% if app.user and c.username == app.user.userIdentifier %}
                                    <span style="display: inline-block; font-size: 9px; background: rgba(0,212,20,0.2); color: #00d414; padding: 1px 5px; border-radius: 4px; margin-left: 4px;">YOU</span>
                                {% endif %}
                            </td>
                            <td style="color: #bbb;">{{ c.email ? c.email : '—' }}</td>
                            <td>
                                {% if c.role == 'admin' %}
                                    <span class="status-badge completed" style="background: rgba(0,212,20,0.15); color:#00d414; border: 1px solid #00d414;">ADMIN</span>
                                {% elseif c.role == 'staff' %}
                                    <span class="status-badge" style="background: rgba(255,215,0,0.15); color:#ffd700; border: 1px solid #ffd700;">STAFF</span>
                                {% else %}
                                    <span class="status-badge pending" style="background: rgba(150,150,150,0.15); color:#aaa; border: 1px solid #666;">CUSTOMER</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if c.status == 'disabled' %}
                                    <span class="status-badge danger" style="background: rgba(220,53,69,0.15); color: #ff5555; border: 1px solid #ff5555;">DISABLED</span>
                                {% else %}
                                    <span class="status-badge" style="background: rgba(0,212,20,0.1); color: #00d414; border: 1px solid rgba(0,212,20,0.3);">ACTIVE</span>
                                {% endif %}
                            </td>
                            <td style="font-size: 12px; color: #888;">{{ c.createdAt|date('M d, Y') }}</td>
                            <td style="text-align: right; white-space: nowrap;">
                                <div class="action-cell" style="justify-content: flex-end; gap: 6px;">
                                    <!-- Edit Button -->
                                    <button type="button" class="btn-admin-outline" 
                                            onclick="openEditUserModal({{ c.id }}, '{{ csrf_token('admin_client_edit_' ~ c.id) }}', '{{ c.username|e('js') }}', '{{ c.email|e('js') }}', '{{ c.role }}', '{{ c.status }}')"
                                            style="padding: 5px 10px; font-size: 11px;">
                                        ✏️ Edit
                                    </button>

                                    <!-- Toggle Status Button -->
                                    {% if not app.user or c.username != app.user.userIdentifier %}
                                        <form method="post" action="{{ path('admin_client_toggle_status', {id: c.id}) }}" style="display:inline; margin:0;">
                                            <button type="submit" class="btn-admin-outline" style="padding: 5px 8px; font-size: 11px; color: {{ c.status == 'disabled' ? '#00d414' : '#ffaa00' }}; border-color: {{ c.status == 'disabled' ? '#00d414' : '#ffaa00' }};">
                                                {{ c.status == 'disabled' ? '✅ Enable' : '⏸️ Disable' }}
                                            </button>
                                        </form>

                                        <!-- Delete Button with Confirmation -->
                                        <form method="post" action="{{ path('admin_client_delete', {id: c.id}) }}" 
                                              style="display:inline; margin:0;" 
                                              onsubmit="return confirm('MANDATORY CONFIRMATION:\nAre you sure you want to permanently delete user account \'{{ c.username }}\'? This action cannot be undone.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_client_delete_' ~ c.id) }}">
                                            <button type="submit" class="btn-admin-danger" style="padding: 5px 9px; font-size: 11px;">🗑️</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL: CREATE USER / STAFF -->
<div id="createUserModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 99999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #121212; border: 1px solid #333; border-radius: 14px; max-width: 500px; width: 100%; padding: 28px; box-shadow: 0 10px 40px rgba(0,0,0,0.6);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #222; padding-bottom: 12px;">
            <h3 style="margin: 0; color: #fff; font-size: 18px;">➕ Create New Account</h3>
            <button type="button" onclick="document.getElementById('createUserModal').style.display='none';" style="background: none; border: none; color: #888; font-size: 22px; cursor: pointer;">&times;</button>
        </div>
        <form method="post" action="{{ path('admin_client_create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_client_create') }}">
            
            <div style="margin-bottom: 15px;">
                <label style="color:#aaa; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">USERNAME *</label>
                <input type="text" name="username" required placeholder="e.g. barista_jane" 
                       style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 6px;">
            </div>

            <div style="margin-bottom: 15px;">
                <label style="color:#aaa; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">EMAIL (OPTIONAL)</label>
                <input type="email" name="email" placeholder="jane@hmcafe.com" 
                       style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 6px;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                <div>
                    <label style="color:#aaa; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">ROLE *</label>
                    <select name="role" style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 6px;">
                        <option value="staff" selected>Staff (Limited Record CRUD)</option>
                        <option value="admin">Admin (Full Control)</option>
                        <option value="customer">Customer (Storefront)</option>
                    </select>
                </div>
                <div>
                    <label style="color:#aaa; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">STATUS *</label>
                    <select name="status" style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 6px;">
                        <option value="active" selected>Active</option>
                        <option value="disabled">Disabled</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 22px;">
                <label style="color:#aaa; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">TEMPORARY PASSWORD *</label>
                <input type="password" name="password" required placeholder="Min 6 characters" 
                       style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 6px;">
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="document.getElementById('createUserModal').style.display='none';" class="btn-admin-outline" style="padding: 10px 16px;">Cancel</button>
                <button type="submit" class="btn-admin-primary" style="padding: 10px 20px;">Create Account</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: EDIT USER -->
<div id="editUserModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 99999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #121212; border: 1px solid #333; border-radius: 14px; max-width: 500px; width: 100%; padding: 28px; box-shadow: 0 10px 40px rgba(0,0,0,0.6);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #222; padding-bottom: 12px;">
            <h3 style="margin: 0; color: #fff; font-size: 18px;">✏️ Edit User Account</h3>
            <button type="button" onclick="document.getElementById('editUserModal').style.display='none';" style="background: none; border: none; color: #888; font-size: 22px; cursor: pointer;">&times;</button>
        </div>
        <form id="editUserForm" method="post" action="">
            <input type="hidden" name="_token" id="editCsrfToken" value="">

            <div style="margin-bottom: 15px;">
                <label style="color:#aaa; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">USERNAME *</label>
                <input type="text" name="username" id="editUsername" required 
                       style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 6px;">
            </div>

            <div style="margin-bottom: 15px;">
                <label style="color:#aaa; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">EMAIL</label>
                <input type="email" name="email" id="editEmail" 
                       style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 6px;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                <div>
                    <label style="color:#aaa; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">ROLE *</label>
                    <select name="role" id="editRole" style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 6px;">
                        <option value="staff">Staff</option>
                        <option value="admin">Admin</option>
                        <option value="customer">Customer</option>
                    </select>
                </div>
                <div>
                    <label style="color:#aaa; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">STATUS *</label>
                    <select name="status" id="editStatus" style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 6px;">
                        <option value="active">Active</option>
                        <option value="disabled">Disabled</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 22px;">
                <label style="color:#ffd700; font-size:11px; display:block; margin-bottom:5px; font-weight:700;">RESET PASSWORD (LEAVE BLANK TO KEEP CURRENT)</label>
                <input type="password" name="new_password" placeholder="Enter new password to reset" 
                       style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #444; color: #fff; border-radius: 6px;">
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="document.getElementById('editUserModal').style.display='none';" class="btn-admin-outline" style="padding: 10px 16px;">Cancel</button>
                <button type="submit" class="btn-admin-primary" style="padding: 10px 20px;">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
function openEditUserModal(id, token, username, email, role, status) {
    const form = document.getElementById('editUserForm');
    form.action = "{{ path('admin_clients') }}/" + id + "/edit";
    document.getElementById('editCsrfToken').value = token;
    document.getElementById('editUsername').value = username;
    document.getElementById('editEmail').value = email || '';
    document.getElementById('editRole').value = role;
    document.getElementById('editStatus').value = status || 'active';
    document.getElementById('editUserModal').style.display = 'flex';
}
</script>
{% endblock %}
