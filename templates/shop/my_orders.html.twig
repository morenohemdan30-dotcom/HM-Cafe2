{% extends 'base.html.twig' %}

{% block title %}HM Café | My Order History{% endblock %}

{% block body %}
<section style="padding: 120px 7% 70px; min-height: 80vh; max-width: 1000px; margin: 0 auto;">
    <div class="section-title">
        <span></span>
        <h2>MY <strong>ORDERS</strong></h2>
        <span></span>
    </div>

    {% if orders is empty %}
        <div style="text-align: center; padding: 60px; background: #111; border-radius: 12px; border: 1px solid #222;">
            <div style="font-size: 40px; margin-bottom: 15px;">☕</div>
            <h3 style="color: #fff; margin-bottom: 10px;">You haven't placed any orders yet.</h3>
            <p style="color: #888; margin-bottom: 25px;">Check out our delicious handcrafted brews and artisanal pastries!</p>
            <a href="{{ path('app_shop') }}" class="hero-btn green-btn">BROWSE MENU &amp; ORDER</a>
        </div>
    {% else %}
        <div style="display: flex; flex-direction: column; gap: 15px;">
            {% for order in orders %}
                <div style="background: #111; border: 1px solid #222; border-radius: 12px; padding: 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                            <span style="color: var(--green); font-weight: 800;">#{{ order.id|format('%04d') }}</span>
                            <span class="status-badge {{ order.status|lower }}">{{ order.status }}</span>
                        </div>
                        <h3 style="color: #fff; margin: 0 0 4px;">{{ order.product ? order.product.name : 'Coffee' }}</h3>
                        <p style="color: #888; margin: 0; font-size: 13px;">
                            Qty: {{ order.quantity }} &bull; {{ order.diningOption }} &bull; {{ order.paymentMethod }} &bull; {{ order.createdAt|date('M d, Y h:i A') }}
                        </p>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 20px; font-weight: 900; color: #ffd700;">₱{{ order.totalPrice|number_format(2) }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
